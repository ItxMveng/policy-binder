# Copier en .env (non versionné) et remplir. Ne jamais committer .env.
# Fournisseur LLM : groq (offre gratuite, https://console.groq.com/keys), mistral (payant) ou ollama (local, sans clé)
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Traces Langfuse (facultatif) : Settings > API Keys du projet sur https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Protection de la démo publique
RATE_LIMIT_PER_IP=10
RATE_LIMIT_WINDOW_S=600
DAILY_QUOTA=300
